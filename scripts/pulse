#!/usr/bin/env bash
# One-command local stack; compatible with macOS's bundled Bash 3.2.
set -euo pipefail

# Resolve the ~/.local/bin/pulse symlink, including paths containing spaces.
script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  case "$script_path" in /*) ;; *) script_path="$script_dir/$script_path" ;; esac
done
project_dir="$(cd -P "$(dirname "$script_path")/.." && pwd)"
cd "$project_dir"

usage() {
  cat <<'HELP'
Usage / 用法：pulse [start|stop|status|logs|data-status|validate|refresh] [--build] [--no-open]
  pulse             Start all services and open the app / 启动全部服务并打开网页
  pulse stop        Stop services, keep data / 停止服务，保留数据
  pulse status      Show service status / 查看服务状态
  pulse logs        Follow logs (Ctrl-C exits logs) / 实时日志
  pulse data-status Show sources and active version / 查看数据版本
  pulse validate    Validate active data / 校验活动数据
  pulse refresh     Refresh due sources safely / 安全更新来源
  pulse --build     Rebuild images and start / 重建镜像后启动
  pulse --no-open   Start without opening browser / 启动但不打开浏览器
HELP
}

action=start
rebuild=0
open_browser=1
for arg in "$@"; do
  case "$arg" in
    start|stop|status|logs|data-status|validate|refresh) action="$arg" ;;
    --build) rebuild=1 ;;
    --no-open) open_browser=0 ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Unknown argument / 未知参数：%s\n' "$arg" >&2; usage >&2; exit 2 ;;
  esac
done

fail() { printf '\nPULSE：%s\n' "$*" >&2; exit 1; }
command -v docker >/dev/null 2>&1 || fail 'Docker not found. Install OrbStack or Docker Desktop. / 未找到 Docker。'
docker compose version >/dev/null 2>&1 || fail 'Docker Compose plugin not found. / 未找到 Compose 插件。'

if ! docker info >/dev/null 2>&1; then
  [ "$action" = start ] || fail 'Docker is stopped; run pulse to start. / Docker 未启动，请运行 pulse。'
  docker_context="$(docker context show)"
  if [ "$(uname -s)" = Darwin ]; then
    case "$docker_context" in
      orbstack)
        printf 'Starting OrbStack / 正在启动 OrbStack…\n'
        open -g -a OrbStack || fail 'Could not open OrbStack. / 无法打开 OrbStack。'
        ;;
      desktop-linux|default)
        printf 'Starting Docker Desktop / 正在启动 Docker Desktop…\n'
        open -g -a Docker || fail 'Could not open Docker Desktop; check the current Docker context. / 请检查 Docker context。'
        ;;
      *) fail "Docker context '$docker_context' is unavailable; start its Docker engine. / 请先启动对应的 Docker 引擎。" ;;
    esac
  else
    fail 'Docker engine is not running; start the Docker service first. / 请先启动 Docker。'
  fi
  deadline=$((SECONDS + 120))
  until docker info >/dev/null 2>&1; do
    [ "$SECONDS" -lt "$deadline" ] || fail 'Docker startup timed out. Check Docker and retry pulse. / 等待 Docker 超时，请检查后重试。'
    sleep 2
  done
fi

export PULSE_UID="$(id -u)"
export PULSE_GID="$(id -g)"
compose=(docker compose --project-name pulse --project-directory "$project_dir" -f "$project_dir/docker-compose.yml" --profile app --profile refresh)

case "$action" in
  stop)
    "${compose[@]}" stop
    printf '\nPULSE stopped; data retained. Run pulse to start again. / 已停止，数据已保留。\n'
    exit 0
    ;;
  status) "${compose[@]}" ps --all; exit 0 ;;
  logs) "${compose[@]}" logs --follow --tail 100; exit 0 ;;
  data-status|validate|refresh)
    data_command="$action"
    [ "$data_command" != data-status ] || data_command=status
    "${compose[@]}" run --rm --no-deps api /app/.venv/bin/pulse-data "$data_command"
    exit 0
    ;;
esac

command -v curl >/dev/null 2>&1 || fail 'curl not found; cannot check application health. / 未找到 curl。'
trap 'printf "\nPULSE startup incomplete; existing data retained. Check errors above or run pulse logs, then retry. / 启动未完成，数据已保留。\n" >&2' ERR
mkdir -p data/raw data/cache data/manifests

printf '\n[1/4] Check images / 检查应用镜像…\n'
build_services=()
for service in api web worker; do
  if [ "$rebuild" -eq 1 ] || ! docker image inspect "pulse-$service" >/dev/null 2>&1; then
    build_services+=("$service")
  fi
done
if [ "${#build_services[@]}" -gt 0 ]; then
  printf 'Building images and downloading dependencies; please wait. / 正在构建镜像并下载依赖…\n'
  "${compose[@]}" build "${build_services[@]}"
fi

printf '\n[2/4] Start database and cache / 启动数据库和缓存…\n'
"${compose[@]}" up -d --wait --wait-timeout 120 postgres redis
"${compose[@]}" run --rm --no-deps api /app/.venv/bin/pulse-data migrate
active_version="$("${compose[@]}" exec -T postgres psql -U pulse -d pulse -Atqc "SELECT id FROM feature_versions WHERE status='active'")"

printf '\n[3/4] Check verified data / 检查真实数据…\n'
if [ -z "$active_version" ]; then
  # Avoid racing a previously started worker on a warehouse awaiting bootstrap.
  "${compose[@]}" stop worker
  printf 'First run: downloading and validating public data, then building models. This can take a while; keep the terminal open. / 首次下载建模，请保持终端打开。\n'
  "${compose[@]}" run --rm --no-deps api /app/.venv/bin/pulse-data bootstrap
  active_version="$("${compose[@]}" exec -T postgres psql -U pulse -d pulse -Atqc "SELECT id FROM feature_versions WHERE status='active'")"
  [ -n "$active_version" ] || fail 'Bootstrap did not produce an active version; inspect pulse logs. / 数据尚未就绪，请查看日志。'
else
  printf 'Using verified version / 复用已验证版本：%s\n' "$active_version"
fi

printf '\n[4/4] Start API, website and refresh worker / 启动完整应用…\n'
"${compose[@]}" up -d --wait --wait-timeout 120 api web worker
deadline=$((SECONDS + 120))
until health="$(curl --fail --silent --max-time 5 http://127.0.0.1:3000/api/health)" \
  && printf '%s' "$health" | grep -Eq '"status"[[:space:]]*:[[:space:]]*"healthy"' \
  && curl --fail --silent --max-time 5 --output /dev/null http://127.0.0.1:3000; do
  [ "$SECONDS" -lt "$deadline" ] || fail 'Application not ready within 120 seconds. Run pulse logs and check ports. / 服务未就绪，请检查日志与端口。'
  sleep 2
done

printf '\nPULSE is ready / 已完整启动 ✓\nWeb / 网页：http://localhost:3000\nAPI：http://localhost:8000/docs\nServices run in the background; you can close this terminal. Stop with: pulse stop / 关闭终端不影响运行。\n'
if [ "$open_browser" -eq 1 ]; then
  if [ "$(uname -s)" = Darwin ]; then
    open http://localhost:3000 || printf 'Open in your browser / 请在浏览器打开 http://localhost:3000\n'
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open http://localhost:3000 >/dev/null 2>&1 || true
  fi
fi
